{
  "profiles": {
    "ProfileService.Api": {
      "commandName": "Project"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": false
    }
  },
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7000",
    "RequestIdKey": "OcRequestId"
  },
  "SwaggerEndPoints": [
    {
      "Key": "account",
      "Config": [
        {
          "Name": "Account API",
          "Version": "v1",
          "Url": "https://localhost:7250/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "job",
      "Config": [
        {
          "Name": "Job API",
          "Version": "v1",
          "Url": "https://localhost:7129/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "profile",
      "Config": [
        {
          "Name": "Profile API",
          "Version": "v1",
          "Url": "https://localhost:7221/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "advertisement",
      "Config": [
        {
          "Name": "Advertisement API",
          "Version": "v1",
          "Url": "https://localhost:7128/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "assessment",
      "Config": [
        {
          "Name": "Assessment API",
          "Version": "v1",
          "Url": "https://localhost:7193/swagger/v1/swagger.json"
        }
      ]
    }
  ],
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7250
        }
      ],
      "UpstreamPathTemplate": "/account/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "SwaggerKey": "account",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": null
      }
    },
    {
      "DownstreamPathTemplate": "/api/account/register",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7250
        }
      ],
      "UpstreamPathTemplate": "/account/register",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": null
      }
    },
    {
      "DownstreamPathTemplate": "/api/account/login",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7250
        }
      ],
      "UpstreamPathTemplate": "/account/login",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": null
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7129
        }
      ],
      "UpstreamPathTemplate": "/job/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "SwaggerKey": "job",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7221
        }
      ],
      "UpstreamPathTemplate": "/profile/{everything}",
      "UpstreamHttpMethod": [
        "GET",
